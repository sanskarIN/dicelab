{
  "name": "dicelab",
  "version": "2.0.14",
  "private": true,
  "description": "A polished offline-first dice simulator for desktop, mobile, and web.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e:infra": "node --test scripts/cdp-session.test.mjs && node --check scripts/e2e-browser.mjs",
    "test:e2e": "node scripts/e2e-browser.mjs",
    "bench": "vitest bench --run",
    "docs:check": "node scripts/check-doc-links.mjs",
    "docs:check:test": "node --test scripts/check-doc-links.test.mjs",
    "docs:inventory": "node scripts/check-file-reference.mjs",
    "docs:inventory:test": "node --test scripts/check-file-reference.test.mjs scripts/check-file-reference.integration.test.mjs",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:secrets:test": "node --test scripts/check-secrets.test.mjs",
    "policy:capabilities": "node scripts/check-capabilities.mjs",
    "policy:tauri-security": "node scripts/check-tauri-security.mjs",
    "policy:offline-csp": "node scripts/check-offline-csp.mjs",
    "policy:localized-formatting": "node scripts/check-localized-formatting.mjs",
    "policy:runtime": "node scripts/check-runtime-boundaries.mjs",
    "policy:native-commands": "node scripts/check-native-command-contract.mjs",
    "policy:lockfiles": "node scripts/check-lockfile-consistency.mjs",
    "policy:pwa": "node --check public/sw.js && node scripts/check-pwa.mjs",
    "policy:pwa:test": "node --test scripts/check-pwa.test.mjs",
    "policy:boundaries": "node scripts/check-policy-boundaries.mjs",
    "policy:test": "node --test scripts/check-capabilities.test.mjs scripts/check-capabilities.integration.test.mjs scripts/check-tauri-security.test.mjs scripts/check-tauri-security.integration.test.mjs scripts/check-offline-csp.test.mjs scripts/check-offline-csp.integration.test.mjs scripts/check-localized-formatting.test.mjs scripts/check-localized-formatting.integration.test.mjs scripts/check-runtime-boundaries.test.mjs scripts/check-runtime-boundaries.integration.test.mjs scripts/check-native-command-contract.test.mjs scripts/check-native-command-contract.integration.test.mjs scripts/check-lockfile-consistency.test.mjs scripts/check-pwa.test.mjs scripts/check-policy-boundaries.integration.test.mjs",
    "policy:all": "npm run policy:boundaries && npm run policy:offline-csp && npm run policy:native-commands && npm run policy:lockfiles && npm run policy:pwa",
    "version:check:test": "node --test scripts/check-version-sync.test.mjs",
    "version:check": "node scripts/check-version-sync.mjs",
    "release:verify": "node scripts/verify-release-packages.mjs",
    "release:verify:test": "node --test scripts/verify-release-packages.test.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build --apk --aab",
    "tauri:ios:init": "tauri ios init",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:ios:build": "tauri ios build",
    "tauri:ios:build:ci": "tauri ios build --ci --target aarch64-sim",
    "tauri:ios:archive:ci": "tauri ios build --ci --no-sign --archive-only"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}